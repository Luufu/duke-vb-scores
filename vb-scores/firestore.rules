rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Anyone can view scores.
      allow read: if true;
      // Only the scorekeeper login can change anything.
      // This email must match scorekeeperEmail in config.js.
      allow write: if request.auth != null
                   && request.auth.token.email == 'scorekeeper@dukeclubvb.app';
    }
  }
}
